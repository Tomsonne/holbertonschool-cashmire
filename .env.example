POSTGRES_DB=cashmire
POSTGRES_USER=cashmire
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql+psycopg://cashmire:local-only-change-me@db:5432/cashmire
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=30
# Origines autorisées pour les écritures (POST, PUT, PATCH, DELETE), séparées par des virgules.
# Format exact d'une origine : http(s)://hote[:port], sans chemin, sans / final, jamais *.
# Exemple : http://localhost:5173,https://cashmire.example
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
